{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerberusmcp.dev/schemas/registry.schema.json",
  "title": "CerberusMCP registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "servers"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_mode": { "enum": ["direct", "gateway"] },
        "log_level": { "type": "string", "enum": ["error", "warn", "info", "debug", "trace"] }
      }
    },
    "active_profile": { "type": ["string", "null"] },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["servers"],
        "properties": {
          "servers": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    },
    "servers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "transport": { "oneOf": [{ "$ref": "#/$defs/stdio" }, { "$ref": "#/$defs/http" }] },
        "mode": { "enum": ["direct", "gateway"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "startup_timeout_ms": { "type": "integer", "minimum": 1 },
        "policy": { "$ref": "#/$defs/policy" },
        "description": { "type": "string" }
      }
    },
    "stdio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command"],
      "properties": {
        "type": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/env_value" }
        },
        "cwd": { "type": "string" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "http" },
        "url": { "type": "string", "pattern": "^https?://" },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/env_value" },
              { "type": "string" }
            ]
          }
        },
        "bearer_token": { "$ref": "#/$defs/env_value" }
      }
    },
    "env_value": {
      "type": "object",
      "required": ["source"],
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "name"],
          "properties": {
            "source": { "const": "env" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "name"],
          "properties": {
            "source": { "const": "secret_ref" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "value"],
          "properties": {
            "source": { "const": "literal" },
            "value": { "type": "string" }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "When non-empty, only these tools are permitted. Trailing `*` wildcard allowed."
        },
        "deny_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools that may never be called. Evaluated after allow_tools."
        },
        "require_confirmation": { "type": "boolean", "default": false }
      }
    }
  }
}
